# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Local secrets — real API keys go here, never commit. See env.example.json.
env.json

# Local editor/assistant and Python environments
.claude/
.venv*/
**/__pycache__/
**/node_modules/

# Platform-specific generated files and local SDK paths
/android/.gradle/
/android/.kotlin/
/android/local.properties
**/flutter/ephemeral/
**/Flutter/ephemeral/
*.apk
*.aab

# Generated ML data and large training artifacts. The deployed TFLite model
# remains versioned under assets/models/.
/ml/captured_dataset/
/training/datasets/
/training/splits/
/training/outputs/
/training/model_backups/
/training/*.zip
*.keras

# Local thesis/delivery working material (not application source)
/deliverables/
/documents/
/work/
/audit_current_screen.png
/*.png
/*.xml
/*.docx
/*.pdf
~$*
